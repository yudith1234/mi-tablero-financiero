rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada persona autenticada solo lee y escribe SU PROPIA carpeta
    // (users/<su-uid>/...). Nadie puede ver ni tocar los datos de otra
    // persona, ni siquiera tú desde la consola salvo que entres como tú misma.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
